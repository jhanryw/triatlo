# Triatlo Inteligente — environment variables (EXAMPLE ONLY: placeholders, never real values).
# Real values live in EasyPanel (production) or in an untracked .env.local (development).
# See docs/INFRASTRUCTURE.md §4 for the full per-service table.

# ---------- apps/web (browser-visible; inlined at BUILD time) ----------
# Supabase is not installed yet (Delivery 1). Leave empty: the app runs without it.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Web Push. Keep false until Delivery 4 (worker + subscription storage) exists.
NEXT_PUBLIC_PUSH_ENABLED=false
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Optional: commit SHA shown by /api/health (set by CI/Docker build arg).
APP_COMMIT_SHA=

# ---------- apps/worker (server only) ----------
WORKER_TICK_SECONDS=30
WORKER_HEALTH_PORT=8081
LOG_LEVEL=info

# ---------- NOT used yet (added in the delivery that needs them; NEVER commit real values) ----------
# DATABASE_URL=               # worker -> Postgres, dedicated least-privilege role (Delivery 2/4)
# SUPABASE_SECRET_KEY=        # privileged key: worker/server only, never NEXT_PUBLIC_, never in the web app
# VAPID_PRIVATE_KEY=          # worker only (Delivery 4)
# VAPID_SUBJECT=mailto:you@example.com
# AI_PROVIDER= / AI_API_KEY= / AI_DAILY_BUDGET=   # only after the AI data disclosure exists (Delivery 5/6)
