# Triatlo Inteligente — environment variables (EXAMPLE ONLY: placeholders, never real values).
# Real values live in EasyPanel (production) or in an untracked .env.local (development).
# See docs/INFRASTRUCTURE.md §4 for the full per-service table.

# ---------- apps/web (public values; read at RUNTIME by the server — set on the running service and restart) ----------
# Without these the app shows the login page with a configuration notice.
NEXT_PUBLIC_SUPABASE_URL=
# PUBLIC key. With the Kong-based production installation this is the legacy ANON JWT (SUPABASE_ANON_KEY also works).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Web Push (needs the worker below + VAPID keys). Public key is the same value as the worker's VAPID_PUBLIC_KEY.
NEXT_PUBLIC_PUSH_ENABLED=false
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Optional: commit SHA shown by /api/health (set by CI/Docker build arg).
APP_COMMIT_SHA=

# ---------- apps/worker (server only; the worker stays idle without the Supabase/VAPID values) ----------
WORKER_TICK_SECONDS=30
WORKER_HEALTH_PORT=8081
LOG_LEVEL=info
# Backend-only. The privileged key must NEVER be set on the web service nor in any NEXT_PUBLIC_* variable.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---------- Meal-photo analysis (apps/web, server only). Off unless BOTH are set AND the user gave consent in Settings ----------
# OPENAI_API_KEY=             # provider key: server-side only, never NEXT_PUBLIC_
# AI_MODEL=                   # no default on purpose: choose a vision-capable model deliberately
# AI_PROVIDER=openai          # label stored in the call log
# AI_BASE_URL=                # any OpenAI-compatible Chat Completions endpoint (default https://api.openai.com/v1)
# AI_DAILY_CALL_LIMIT=30      # hard daily budget of provider calls
