# Triatlo Inteligente — self-hosted Supabase (stack upstream self-hosted/v0.8.3, adapted for EasyPanel)
#
# THIS FILE CONTAINS NO SECRETS: secret values are intentionally EMPTY and are generated locally by
#   infra/supabase/scripts/prepare-env.sh   (uses the official upstream generators, writes OUTSIDE the repository)
# The generated file is pasted into EasyPanel's .env editor of the Compose service. Never commit it.
#
# Lines marked "REPLACE_WITH_..." must be filled with the HTTPS addresses EasyPanel generates for you.

COMPOSE_FILE=docker-compose.yml

############
# Secrets (generated — leave empty here)
############
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
JWT_KEYS=
JWT_JWKS=
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=
SECRET_KEY_BASE=
REALTIME_DB_ENC_KEY=
VAULT_ENC_KEY=
PG_META_CRYPTO_KEY=
LOGFLARE_PUBLIC_ACCESS_TOKEN=
LOGFLARE_PRIVATE_ACCESS_TOKEN=
S3_PROTOCOL_ACCESS_KEY_ID=
S3_PROTOCOL_ACCESS_KEY_SECRET=
MINIO_ROOT_PASSWORD=

# Studio / gateway Basic Auth (non-default username; password generated)
DASHBOARD_USERNAME=triatlo_admin
DASHBOARD_PASSWORD=

############
# Public URLs (HTTPS addresses generated by EasyPanel)
############
# API gateway origin used by the browser, e.g. https://<generated-api-host>  (no trailing slash, no path)
SUPABASE_PUBLIC_URL=REPLACE_WITH_API_HTTPS_URL
# Same origin + /auth/v1
API_EXTERNAL_URL=REPLACE_WITH_API_HTTPS_URL/auth/v1
# Origin of the Next.js web app (where users land after email links) — no trailing slash
SITE_URL=REPLACE_WITH_APP_HTTPS_URL
ADDITIONAL_REDIRECT_URLS=

############
# Database (internal only — never published)
############
POSTGRES_HOST=db
POSTGRES_DB=postgres
POSTGRES_PORT=5432

POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_TENANT_ID=triatlo
POOLER_DB_POOL_SIZE=5

############
# Studio
############
STUDIO_DEFAULT_ORGANIZATION=Triatlo Inteligente
STUDIO_DEFAULT_PROJECT=Triatlo Inteligente
# Left empty on purpose: the Studio AI assistant stays disabled and nothing is sent to an AI provider.
OPENAI_API_KEY=

############
# Auth — single-user personal use
############
JWT_EXPIRY=3600
# Public sign-up OFF from the very first start. Your account is created by an administrator (Studio → Authentication
# → Add user, with "Auto Confirm User"), which still works while sign-up is disabled.
DISABLE_SIGNUP=true

MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"

# Email + password login is the only method. Phone, anonymous users and social providers are disabled/not configured.
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false

# No SMTP server yet (pending decision Q-05): e-mail delivery (password recovery, e-mail change) will fail until a real
# SMTP provider is configured. These are non-functional placeholders, not credentials.
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=supabase-mail
SMTP_PORT=2500
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_NAME=Triatlo Inteligente

############
# Storage (local file backend inside the storage-data volume; buckets are created private by migrations)
############
GLOBAL_S3_BUCKET=stub
REGION=stub
MINIO_ROOT_USER=triatlo-storage
STORAGE_TENANT_ID=stub

############
# Edge Functions (unused; if ever enabled, require a valid JWT)
############
FUNCTIONS_VERIFY_JWT=true

############
# PostgREST
############
PGRST_DB_SCHEMAS=public,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public

############
# imgproxy
############
IMGPROXY_AUTO_WEBP=true

############
# Backup sidecar (see infra/backup and docs/SUPABASE_EASYPANEL.md §7)
############
BACKUP_HOUR_UTC=6
BACKUP_RETENTION_DAYS=14
# Optional AES-256 encryption of every artifact. Leave empty until `openssl` is confirmed inside the sidecar image.
BACKUP_ENCRYPTION_PASSPHRASE=
