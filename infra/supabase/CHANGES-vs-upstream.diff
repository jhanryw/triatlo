+  # Triatlo addition: scheduled logical backups + operations container (see docs/SUPABASE_RUNBOOK.md and infra/backup/).
+  # Dumps land in the db-backups volume; copying that volume OFF the server is a separate, required step.
+  backup:
+    image: supabase/postgres:17.6.1.136
+    restart: unless-stopped
+    depends_on:
+      db:
+        condition: service_healthy
+    volumes:
+      - ./backup/backup.sh:/backup.sh:ro
+      # Operations: the repository's supabase/ folder (migrations, runner, tests) is mounted read-only so migrations can be
+      # applied from this container's console (PG* variables below already authenticate against db), without publishing
+      # the database port. Requires the Git checkout to contain the whole repository (verify: ls /supabase/migrations).
+      - ../../supabase:/supabase:ro
+      - storage-data:/var/lib/storage:ro
+      - db-backups:/backups
+    environment:
+      PGHOST: db
+      PGPORT: ${POSTGRES_PORT}
+      PGDATABASE: ${POSTGRES_DB}
+      PGUSER: supabase_admin
+      PGPASSWORD: ${POSTGRES_PASSWORD}
+      BACKUP_DIR: /backups
+      BACKUP_HOUR_UTC: ${BACKUP_HOUR_UTC:-6}
+      BACKUP_RETENTION_DAYS: ${BACKUP_RETENTION_DAYS:-14}
+      BACKUP_ENCRYPTION_PASSPHRASE: ${BACKUP_ENCRYPTION_PASSPHRASE:-}
+    entrypoint: ["/bin/bash", "/backup.sh"]
