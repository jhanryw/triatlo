{
  "name": "triatlo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Triatlo Inteligente — personal training, nutrition and recovery app",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.9.0"
  },
  "packageManager": "npm@10.9.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @triatlo/web",
    "dev:worker": "npm run dev -w @triatlo/worker",
    "lint": "eslint . && npm run lint -w @triatlo/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "security:check": "node scripts/security-check.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run security:check"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "globals": "17.13.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1"
  }
}
